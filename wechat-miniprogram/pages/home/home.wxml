<!-- pages/home/home.wxml · 患者端首页 -->
<view class="container">
  <!-- 离线提示条 -->
  <view wx:if="{{!backendOnline}}" class="offline-bar">
    📡 当前为本地演示数据模式 · 联网后体验真实 AI
  </view>

  <!-- 顶部 Hero -->
  <view class="hero-gradient">
    <view class="hero-greeting">您好, {{userName || '访客'}} 👋</view>
    <view class="hero-tip">今天感觉怎么样?有什么不舒服可以问问 AI</view>

    <view class="search-bar" bindtap="goTriage">
      <text class="search-icon">🔍</text>
      <text class="search-text">头痛、发烧、咳嗽 · AI 一对一问诊</text>
    </view>

    <view class="hero-stats">
      <view class="stat-item">
        <view class="stat-num">{{stats.reports}}</view>
        <view class="stat-label">报告</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-num">{{stats.prescriptions}}</view>
        <view class="stat-label">处方</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-num">{{stats.visits}}</view>
        <view class="stat-label">就诊</view>
      </view>
    </view>
  </view>

  <!-- 核心服务入口 -->
  <view class="quick-grid">
    <view class="quick-card" bindtap="goTriage">
      <view class="quick-icon" style="background:linear-gradient(135deg,#0EA5A4,#10B981)">🤖</view>
      <view class="quick-title">AI 预问诊</view>
      <view class="quick-desc">5 分钟整理病情</view>
    </view>
    <view class="quick-card" bindtap="goDepts">
      <view class="quick-icon" style="background:linear-gradient(135deg,#2563EB,#7C3AED)">🏥</view>
      <view class="quick-title">智能分诊</view>
      <view class="quick-desc">找对科室不绕路</view>
    </view>
    <view class="quick-card" bindtap="goReport">
      <view class="quick-icon" style="background:linear-gradient(135deg,#F59E0B,#EF4444)">📋</view>
      <view class="quick-title">报告解读</view>
      <view class="quick-desc">通俗易懂的 AI 解读</view>
    </view>
    <view class="quick-card" bindtap="goMeds">
      <view class="quick-icon" style="background:linear-gradient(135deg,#EC4899,#7C3AED)">💊</view>
      <view class="quick-title">用药提醒</view>
      <view class="quick-desc">按时吃药不忘记</view>
    </view>
  </view>

  <!-- 今日提醒 -->
  <view class="section-title">
    <text>今日提醒</text>
    <text class="more">查看全部 ></text>
  </view>
  <view class="card">
    <view wx:if="{{todayReminders.length === 0}}" class="empty">今日暂无提醒</view>
    <view wx:for="{{todayReminders}}" wx:key="id" class="reminder-row">
      <view class="reminder-icon">{{item.icon}}</view>
      <view class="reminder-content">
        <view class="reminder-title">{{item.title}}</view>
        <view class="reminder-time">{{item.time}}</view>
      </view>
      <view class="tag tag-{{item.tagColor}}">{{item.status}}</view>
    </view>
  </view>

  <!-- 健康资讯 -->
  <view class="section-title">
    <text>健康资讯</text>
    <text class="more">更多 ></text>
  </view>
  <view class="news-list">
    <view wx:for="{{news}}" wx:key="id" class="news-card">
      <view class="news-title">{{item.title}}</view>
      <view class="news-meta">
        <text>{{item.source}}</text>
        <text>·</text>
        <text>{{item.read}} 阅读</text>
      </view>
    </view>
  </view>

  <view class="footer-tip">
    🔒 您的健康数据已加密 · 等保三级 · 仅医生可查
  </view>
</view>
