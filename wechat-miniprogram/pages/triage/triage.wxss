/* AI 预问诊样式 */
.triage-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #F0FDFA 0%, #F8FAFC 30%);
}

.progress-bar {
  padding: 24rpx 32rpx 16rpx;
  background: #fff;
  border-bottom: 2rpx solid #E2E8F0;
}

.progress-track {
  height: 8rpx;
  background: #E2E8F0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0EA5A4, #2563EB);
  transition: width 0.4s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
  text-align: center;
}

.chat-area {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 24rpx;
}

.msg-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.msg-row.user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.msg-avatar.ai { background: linear-gradient(135deg, #0EA5A4, #2563EB); }
.msg-avatar.user { background: linear-gradient(135deg, #F59E0B, #EF4444); }

.msg-bubble {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
}

.msg-bubble.ai {
  background: #fff;
  border: 2rpx solid #E2E8F0;
  border-bottom-left-radius: 4rpx;
  color: #0F172A;
}

.msg-bubble.user {
  background: linear-gradient(135deg, #0EA5A4, #2563EB);
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.msg-options {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.opt-btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  background: #F0FDFA;
  color: #0F766E;
  border-radius: 100rpx;
  border: 2rpx solid #CCFBF1;
}

.opt-btn:active {
  background: #0EA5A4;
  color: #fff;
}

.typing {
  display: flex;
  gap: 8rpx;
  padding: 24rpx;
}

.typing .dot {
  width: 12rpx;
  height: 12rpx;
  background: #0EA5A4;
  border-radius: 50%;
  animation: bounce 1.4s infinite;
}

.typing .dot:nth-child(2) { animation-delay: 0.2s; }
.typing .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-12rpx); opacity: 1; }
}

.summary-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.08);
}

.summary-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F1F5F9;
}

.urgency-high { color: #EF4444; font-size: 24rpx; }
.urgency-mid { color: #F59E0B; font-size: 24rpx; }
.urgency-low { color: #10B981; font-size: 24rpx; }

.summary-row {
  display: flex;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.summary-row .label {
  font-weight: 600;
  color: #475569;
  width: 140rpx;
  flex-shrink: 0;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
}

.warning-box {
  background: #FEF3C7;
  border-left: 6rpx solid #F59E0B;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #92400E;
  margin: 16rpx 0;
}

.summary-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.summary-actions button {
  flex: 1;
}

.input-area {
  background: #fff;
  padding: 16rpx 24rpx;
  border-top: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input-box {
  flex: 1;
  background: #F1F5F9;
  border-radius: 100rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
}

.voice-btn {
  width: 80rpx;
  height: 80rpx;
  background: #F1F5F9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.send-btn {
  background: linear-gradient(135deg, #0EA5A4, #2563EB);
  color: #fff;
  padding: 20rpx 32rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.offline-bar {
  background: #FEF3C7;
  color: #92400E;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx;
}

.theme-primary { color: #0EA5A4; font-weight: 600; }
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-teal { background: #F0FDFA; color: #0F766E; }
.tag-blue { background: #EFF6FF; color: #1E40AF; }
