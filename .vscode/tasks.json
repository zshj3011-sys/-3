{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "安装后端依赖",
      "type": "shell",
      "command": "pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/medmind-backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "启动后端 (热重载)",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/medmind-backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/medmind-backend"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "运行 pytest 测试",
      "type": "shell",
      "command": "pytest tests/ -v",
      "options": {
        "cwd": "${workspaceFolder}/medmind-backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/medmind-backend"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "重新播种演示数据",
      "type": "shell",
      "command": "python -m scripts.seed",
      "options": {
        "cwd": "${workspaceFolder}/medmind-backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/medmind-backend"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}