/* pages/home/home.wxss */

.hero-greeting {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-tip {
  font-size: 26rpx;
  opacity: 0.92;
  margin-bottom: 28rpx;
}

.search-bar {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(10rpx);
  border-radius: 100rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.search-icon {
  font-size: 28rpx;
}

.search-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 24rpx;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 24rpx;
  margin-top: -32rpx;
}

.quick-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 16rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.quick-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 4rpx;
}

.quick-desc {
  font-size: 22rpx;
  color: #64748B;
}

.reminder-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F1F5F9;
}

.reminder-row:last-child {
  border-bottom: none;
}

.reminder-icon {
  width: 72rpx;
  height: 72rpx;
  background: #F0FDFA;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.reminder-content {
  flex: 1;
}

.reminder-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
}

.reminder-time {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.news-list {
  padding: 0 24rpx 24rpx;
}

.news-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.news-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
  line-height: 1.5;
}

.news-meta {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 8rpx;
  display: flex;
  gap: 8rpx;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #94A3B8;
  padding: 24rpx 0 48rpx;
}
