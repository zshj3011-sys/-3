# ==================== MedMind Nexus 后端 · 环境变量示例 ====================
# 复制为 .env 后修改实际值

# === 应用 ===
APP_NAME=MedMind Nexus API
APP_ENV=development                  # development | staging | production
DEBUG=true
API_V1_PREFIX=/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5500

# === 数据库 ===
# 开发: SQLite (零依赖,直接跑通)
DATABASE_URL=sqlite+aiosqlite:///./medmind.db
# 生产: PostgreSQL 16+ (推荐 + TimescaleDB)
# DATABASE_URL=postgresql+asyncpg://medmind:strongpassword@localhost:5432/medmind

# === 安全 ===
# 生产环境务必更换! 可用 `openssl rand -hex 32` 生成
SECRET_KEY=dev-secret-key-please-change-in-production-3f4a8b2c9d1e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# === LLM 大模型 ===
# 支持任意 OpenAI 兼容协议: DeepSeek / 通义 / 智谱 / Moonshot 等
# 留空则使用内置 Mock (零成本演示)
LLM_PROVIDER=mock                    # mock | openai | deepseek | qwen | zhipu
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# === 医疗大模型（可选, 走独立通道）===
MEDICAL_LLM_API_KEY=
MEDICAL_LLM_API_BASE=
MEDICAL_LLM_MODEL=

# === Redis (可选, 缓存/限流) ===
REDIS_URL=

# === 向量库 (可选, RAG用) ===
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# === 文件存储 ===
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=20971520             # 20MB

# === 演示模式 ===
# 启用后, AI 服务会返回脱敏样例数据, 适合演示
DEMO_MODE=true
